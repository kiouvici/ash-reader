+/* ASH (I-713, 7G): Korean justification that looks like Ridibooks/Kyobo.
+ *
+ * With word-break: keep-all a justified line can only stretch at spaces, so a
+ * line with few words gets gaps of 1-2em ("세부    일정을    아래와"), while
+ * spreading the slack between letters at 0.2em looked spaced out ("냄 새 가 났
+ * 다"). We keep the line breaks exactly as they are (keep-all and kinsoku
+ * untouched) and only change how a justified line distributes its slack:
+ *  1. spaces grow until a word gap is ASH_MAX_GAP em wide,
+ *  2. then a hardly visible ASH_MAX_LS em goes between letters of CJK runs,
+ *  3. what is still left goes back to the spaces when the line has more than
+ *     ASH_RAGGED_SPACES spaces; a line with fewer spaces (one or two long
+ *     words) is left ragged-right (left aligned, natural spacing) instead of
+ *     spacing its letters or opening one huge gap. */
+#define ASH_MAX_GAP 0.7f
+#define ASH_MAX_LS 0.05f
+#define ASH_RAGGED_SPACES 2
+#define ASH_RAGGED_TOL 0.05f
+
+static int ash_ls_char(int c)
+{
+	return (c >= 0xAC00 && c <= 0xD7A3) || (c >= 0x1100 && c <= 0x11FF) ||
+		(c >= 0x3130 && c <= 0x318F) || (c >= 0x3040 && c <= 0x30FF) ||
+		(c >= 0x3400 && c <= 0x4DBF) || (c >= 0x4E00 && c <= 0x9FFF) ||
+		(c >= 0xF900 && c <= 0xFAFF);
+}
+
+static int ash_ls_mark(int c)
+{
+	return (c >= 0x0300 && c <= 0x036F) || (c >= 0x1160 && c <= 0x11FF) ||
+		(c >= 0x302A && c <= 0x302F) || (c >= 0xFE00 && c <= 0xFE0F) || c == 0x200D;
+}
+
+/* Is there a stretchable letter gap between prev and c (both inside one word)? */
+static int ash_ls_gap(int prev, int c)
+{
+	if (prev <= 0 || c <= 0 || ash_ls_mark(c))
+		return 0;
+	return ash_ls_char(prev) || ash_ls_char(c);
+}
+
+static int ash_ls_gaps(const char *s)
+{
+	int n = 0, prev = 0, c;
+	while (*s)
+	{
+		s += fz_chartorune(&c, s);
+		if (ash_ls_gap(prev, c))
+			n++;
+		if (!ash_ls_mark(c))
+			prev = c;
+	}
+	return n;
+}
+
+static float ash_node_w(fz_html_flow *node)
+{
+	if (node->type == FLOW_WORD && node->ash_ls != 0)
+		return node->w + node->ash_ls * ash_ls_gaps(node->content.text);
+	return node->w;
+}
