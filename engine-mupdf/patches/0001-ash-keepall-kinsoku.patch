+/* ASH (F-38): Korean line-start / line-end prohibition for forced breaks. */
+static int ash_is_no_start(int c)
+{
+	return c == '.' || c == ',' || c == '!' || c == '?' || c == ':' || c == ';' || c == ')' ||
+		c == ']' || c == '}' || c == '%' || c == 0x2026 || c == 0x300D || c == 0x300F ||
+		c == 0x201D || c == 0x2019 || c == 0x3002 || c == 0x3001 || c == 0x2103 ||
+		c == 0xFF09 || c == 0xFF0C || c == 0xFF0E;
+}
+
+static int ash_is_no_end(int c)
+{
+	return c == '(' || c == '[' || c == '{' || c == 0x300C || c == 0x300E ||
+		c == 0x201C || c == 0x2018 || c == 0xFF08;
+}
+
+static int ash_kinsoku_forbids(const char *text, size_t at)
+{
+	int next, prev = 0;
+	const char *p = text, *last = NULL;
+	if (at == 0 || text[at] == 0)
+		return 0;
+	fz_chartorune(&next, text + at);
+	while (p < text + at)
+	{
+		last = p;
+		p += fz_chartorune(&prev, p);
+	}
+	(void)last;
+	return ash_is_no_start(next) || ash_is_no_end(prev);
+}
