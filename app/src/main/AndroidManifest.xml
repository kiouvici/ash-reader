<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- N-05: INTERNET 권한 없음. 라이브러리가 끌어오면 :app:check*NoInternetPermission 이 빌드를 실패시킨다.
         (tools:node="remove" 로 몰래 지우지 말고, 원인 라이브러리를 검토할 것) -->

    <!-- F-01 저장소 접근(기술 설계서 7.2): Android 8~10 은 읽기 권한(10 은 requestLegacyExternalStorage),
         Android 11+ 는 '모든 파일 접근'(사이드로드 배포라 Play 정책 대상 아님). 거부하면 SAF 폴더 고르기로 대신한다.
         maxSdkVersion 을 두지 않는다(11+ 에서는 MANAGE 가 대신함). 원본은 읽기만 한다(N-04). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- F-13 듣기: 화면이 꺼져도 계속 읽는 미디어 포그라운드 서비스와 그 알림(Android 13+ 알림 권한은 처음 들을 때 묻는다).
         TTS 는 기기에 깔린 엔진을 쓰며 인터넷 권한은 여전히 없다(N-05). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- F-36·F-66: 패키지 조회는 필요한 것만 선언(QUERY_ALL_PACKAGES 금지).
         서점 앱 고르기는 런처 앱(MAIN/LAUNCHER) 조회, Play 스토어 유무는 market:// 조회. -->
    <queries>
        <package android:name="kr.vici.malgeul" />
        <package android:name="com.yes24.ebook.fourth" />
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- F-13: 기기 TTS 엔진 찾기(Android 11+ 패키지 공개 범위) -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".AshApp"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.AshReader"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- S-40: 다른 앱(카톡·파일 앱)에서 연 문서 = 한 번만 보기.
                 content:// 만 받는다(file:// 은 다른 앱의 경로 노출·우리 내부 파일 지정 위험, 웹 링크용 BROWSABLE 도 받지 않음).
                 앱 전용 폴더를 가리키는 URI 는 MainActivity.safeIncoming 에서 거부한다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-hwp" />
                <data android:mimeType="application/haansofthwp" />
                <data android:mimeType="application/vnd.hancom.hwp" />
                <data android:mimeType="application/hwp+zip" />
                <data android:mimeType="application/vnd.hancom.hwpx" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/vnd.comicbook-rar" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/x-cbr" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-mobi8-ebook" />
                <data android:mimeType="application/vnd.amazon.ebook" />
                <data android:mimeType="application/vnd.amazon.mobi8-ebook" />
                <data android:mimeType="image/vnd.djvu" />
                <data android:mimeType="image/x-djvu" />
                <data android:mimeType="application/vnd.ms-htmlhelp" />
                <data android:mimeType="application/x-chm" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/xhtml+xml" />
                <data android:mimeType="text/x-fb2+xml" />
                <data android:mimeType="application/x-fb2" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- F-05 공유하기: 한 개(SEND)·여러 개(SEND_MULTIPLE). 문서·만화는 application/*, TXT·HTML·RTF 는 text/*,
                 DjVu 는 image/vnd.djvu·image/x-djvu. 사진(image/*) 전체는 받지 않는다(만화 쪽 그림 공유와 헷갈림 방지).
                 여러 개는 서재에 넣는다. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/vnd.djvu" />
                <data android:mimeType="image/x-djvu" />
            </intent-filter>
        </activity>
        <!-- F-13 듣기(S-27): 미디어 재생 포그라운드 서비스. 밖에 공개하지 않는다. -->
        <service
            android:name=".tts.ListenService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- F-59 쪽 그림 공유: 캐시의 share/ 폴더만 내준다(밖에 공개하지 않고, 받는 앱에 그때그때 읽기 권한만). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>
</manifest>
