<!-- N-05(작업 06): 책 정보 찾기는 HTTPS 만. 평문(HTTP) 연결은 모두 막는다. 사용자가 깐 인증서는 믿지 않는다(시스템 인증서만). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>